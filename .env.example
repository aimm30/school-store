# --- Required ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_store?schema=public"
APP_URL="http://localhost:3000"

# --- Store identity (shown across the site and in legal pages) ---
STORE_NAME="Kanjirowa Student Store"
SCHOOL_NAME="Kanjirowa National School"
ORDER_PREFIX="KNS"
# Leave blank until the school confirms them. Legal/contact pages show a "to be confirmed" notice for blank values.
CONTACT_EMAIL=""
CONTACT_PHONE=""
SCHOOL_ADDRESS=""
STORE_HOURS=""
PRIVACY_CONTACT_EMAIL=""

# --- Commerce ---
DELIVERY_FEE_NPR="0"
LOW_STOCK_THRESHOLD="5"

# --- Seeding (npm run db:seed) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Store Administrator"
# Choose your own strong password. It is only used by the seed script and is never stored in plain text.
SEED_ADMIN_PASSWORD=""
# "true" also inserts SAMPLE products with PLACEHOLDER prices. Never use in production.
SEED_SAMPLE_PRODUCTS="false"

# --- Image storage: "local" (default) or "s3" (any S3-compatible service) ---
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for objects, e.g. https://cdn.example.com (no trailing slash)
S3_PUBLIC_URL=""

# --- Email (verification + password reset). Without SMTP, links are printed to the server log in development only. ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kanjirowa Student Store <no-reply@example.com>"

# --- Tests ---
# A separate, disposable database used by `npm test` integration tests.
TEST_DATABASE_URL=""
